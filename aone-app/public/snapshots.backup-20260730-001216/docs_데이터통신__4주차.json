      "emphasis": [
        {
          "quote": "변종 그래서 여러분들이 모든 통신회사는 필수적으로 들어가기 때문에 반드시 이해를 해야 돼요.",
          "locator": "00:35",
          "concept": "변조/복조"
        },
        {
          "quote": "그래서 여기 핵심 단어가 모듈레이션이라는 기술은 여러 가지가 있어요.",
          "locator": "07:42",
          "concept": "변조/복조"
        },
        {
          "quote": "그다음에 여기도 마찬가지 뭔가 살짝 살짝 틀어지는 거 그래서 재생을 얼마나 잘 해야 될까라는 이게 아주 중요한 뇌의 신호를 복구할 수 있는 변수 중에 하나입니다.",
          "locator": "19:15",
          "concept": "샘플링(샘플)"
        },
        {
          "quote": "크기 위상 잘 기억해야 돼요.",
          "locator": "48:40",
          "concept": "진폭(크기)"
        },
        {
          "quote": "크기 위상 잘 기억해야 돼요.",
          "locator": "48:40",
          "concept": "위상"
        },
        {
          "quote": "첫 번째 크기 여러분들 오늘 이거는 기억하고 가야 됩니다.",
          "locator": "1:05:34",
          "concept": "진폭(크기)"
        },
        {
          "quote": "반드시 기억해야 돼요.",
          "locator": "1:07:26",
          "concept": "QAM"
        },
        {
          "quote": "임심히 보세요.",
          "locator": "1:07:26",
          "concept": "QAM"
        },
        {
          "quote": "여러분들 오늘 월요일 이 아침에 10시에 왔을 때 꼭 여러분들 얻고 가야 되는 것 중에 하나가 지식입니다.",
          "locator": "1:07:26",
          "concept": "QAM"
        },
        {
          "quote": "그러니까 저 앞에 있는 숫자가 높으면 속도가 빨라지는 거야.",
          "locator": "52:00",
          "concept": "심볼당 비트수(변조 차수)"
        },
        {
          "quote": "이 통신의 1 원칙 1 원칙 사실 오류가 있다 있을 수 있다.",
          "locator": "1:16:50",
          "concept": "오류 탐지와 복구"
        },
        {
          "quote": "탐지 탐지가 첫 번째입니다.",
          "locator": "1:18:08",
          "concept": "오류 탐지와 복구"
        },
        {
          "quote": "마스크 코드를 이제 제일 중요한 것 중에 하나가 오류가 있다.",
          "locator": "1:21:42",
          "concept": "오류 탐지와 복구"
        },
        {
          "quote": "제2 분반 수업 들은 친구는 뿌리의 변화 모른다고 그러면 간첩입니다.",
          "locator": "1:24:00",
          "concept": "푸리에 변환"
        },
        {
          "quote": "이게 그냥 나오는 게 아니고 통신할 때 수신자 파트에서 주파수를 찾을 때 무조건 써야 되는 기술입니다.",
          "locator": "1:24:49",
          "concept": "푸리에 변환"
        },
        {
          "quote": "그래서 그게 모든 통신의 기초다라고 생각해야 됩니다.",
          "locator": "1:26:01",
          "concept": "푸리에 변환"
        }
      ],
      "examHints": [
